<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Larpnet">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Larpnet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Catches the OAuth2 redirect from the server's /oauth/authorize browser flow
          (see data/auth/OAuthFlow.kt). The scheme/host here MUST stay byte-identical to
          BuildConfig.OAUTH_REDIRECT_URI, since the server matches redirect_uri exactly
          across app registration, the authorize request, and the token exchange.
        -->
        <activity
            android:name=".ui.login.OAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pl.larpnet.android" android:host="oauth" />
            </intent-filter>
        </activity>

        <!--
          Play Store flavor's push transport (see BuildConfig.FCM_PUSH_ENABLED, push/PushControl.kt).
          Declared unconditionally (harmless on the github flavor too, which declares its own
          NtfyListenerService in src/github/AndroidManifest.xml) since auto-init is off by default
          just below: Firebase never generates a token, so this service never receives anything,
          unless PushControl explicitly turns auto-init on.
        -->
        <service
            android:name=".push.LarpnetFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- Used only when a notification arrives while the app is backgrounded/killed, in
          which case the system builds and posts it directly, bypassing onMessageReceived. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <!-- Must stay byte-identical to PushNotifications.CHANNEL_MESSAGES. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="larpnet_push_messages" />

        <!--
          Enables AppCompatDelegate.setApplicationLocales() to actually persist the choice
          and apply it on next launch. MainActivity is a plain ComponentActivity, not
          AppCompatActivity, so without this the call only affects the current process's
          in-memory state, never writes through to the OS's per-app locale storage, and is
          lost on the very next app start: confirmed via `adb shell cmd locale
          get-app-locales`, which kept returning [] right after a successful, no-exception call.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
