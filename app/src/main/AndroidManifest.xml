<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Larpnet">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Larpnet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Catches the OAuth2 redirect from the server's /oauth/authorize browser flow
          (see data/auth/OAuthFlow.kt). The scheme/host here MUST stay byte-identical to
          BuildConfig.OAUTH_REDIRECT_URI, since the server matches redirect_uri exactly
          across app registration, the authorize request, and the token exchange.
        -->
        <activity
            android:name=".ui.login.OAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pl.larpnet.android" android:host="oauth" />
            </intent-filter>
        </activity>

        <!--
          Holds the long-lived connection to push.larpnet.pl's ntfy relay (see push/NtfyListenerService.kt).
          specialUse is the correct Android 14+ foreground-service type for "listen for pushes without
          Firebase/UnifiedPush": none of the other enumerated types (dataSync, connectedDevice, etc.) fit,
          and dataSync in particular carries a 6h background execution cap on Android 15+ that would kill
          this on a timer. specialUse has no such cap; its only OS-side requirement is this property.
        -->
        <service
            android:name=".push.NtfyListenerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="push-notifications-listener" />
        </service>

        <!--
          Enables AppCompatDelegate.setApplicationLocales() to actually persist the choice
          and apply it on next launch. MainActivity is a plain ComponentActivity, not
          AppCompatActivity, so without this the call only affects the current process's
          in-memory state, never writes through to the OS's per-app locale storage, and is
          lost on the very next app start: confirmed via `adb shell cmd locale
          get-app-locales`, which kept returning [] right after a successful, no-exception call.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
